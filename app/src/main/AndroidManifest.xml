<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"
        tools:targetApi="36" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Android 11 and older gate Bluetooth state, connection broadcasts and scans on these. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="${smsPermissionName}" />
    <uses-permission
        android:name="${smsReceivePermissionName}" />
    <uses-permission
        android:name="${smsMmsPermissionName}"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="${smsWapPushPermissionName}"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="${phoneStatePermissionName}" />
    <uses-permission
        android:name="${callLogPermissionName}" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        Special access, granted only through Settings > Modify system settings. Required by the
        brightness.set and screen.timeout actions, which advertise it as their setup requirement;
        without the declaration Settings.System.canWrite() can never become true and both actions
        would fail forever while claiming to be one grant away.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!--
        Special access, granted only through Settings > Notifications > Do Not Disturb access
        (renamed "Modes access" on Android 16). The system builds that list from apps that
        declare this permission, so without it OpenTasker never appears on the page, the
        isNotificationPolicyAccessGranted() checks behind dnd.set / zen.rule.set / zen.rule.clear
        can never become true, and the Setup row sends the user to a screen that cannot grant
        anything (issue #4).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
        Never granted by installing, and no dialog can ask for it: a user grants it once over a
        cable with `adb shell pm grant`, which is exactly the route Tasker documents. The
        declaration is what makes that command possible at all - `pm grant` refuses a permission
        the package does not declare - so without this line the Setup row would hand out a command
        that always fails. Only the settings.write action uses it, and only for the Global and
        Secure tables.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Lets a profile bring a WireGuard tunnel up or down. WireGuard declares this as a runtime
         permission, and Setup only asks for it when WireGuard is installed. -->
    <uses-permission android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <!--
        Android 8 to 12 refuse every CompanionDeviceManager call from an app that doesn't declare
        this feature, on any device that has it, with an IllegalStateException. Setup and Settings
        list paired devices on open, so both crashed on Galaxy phones running Android 10 (#20).
        Not required: a device without it just has nothing to pair.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <permission
        android:name="com.opentasker.permission.AUTOMATION"
        android:description="@string/permission_automation_description"
        android:label="@string/permission_automation_label"
        android:protectionLevel="signature" />
    <!-- Declaring a permission doesn't grant it. Scene buttons and Locale plugin fires send their
         run request with this as the receiver permission, and Android delivers such a broadcast
         only to a package that holds it, the sender's own included. -->
    <uses-permission android:name="com.opentasker.permission.AUTOMATION" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.wireguard.android" />
        <package android:name="com.tailscale.ipn" />
        <!-- Scoped visibility for the shared installed-app picker; QUERY_ALL_PACKAGES is forbidden. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.EDIT_CONDITION" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
        </intent>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.REQUEST_QUERY" />
        </intent>
    </queries>

    <application
        android:name=".OpenTaskerApp_NoHilt"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.OpenTasker"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s">

        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
            singleTop is required for the NFC alias below, not a preference. Manifest NFC dispatch
            delivers a tag to a standard-launchMode activity by starting a *new* instance, so
            onNewIntent never ran and every tap stacked another copy of the app: the armed tag-write
            editor stayed buried in the back stack while its result was delivered to the instance
            the user could no longer see.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Tags come in here, never on MainActivity directly. Only the NFC service holds
            DISPATCH_NFC_MESSAGE, so another app's forged TAG_DISCOVERED start is refused, and
            NfcDeliveryGate ignores tag intents that didn't arrive through this alias.
        -->
        <activity-alias
            android:name=".NfcTagDispatch"
            android:exported="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.opentasker.core.contexts.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:grantUriPermissions="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.core.actions.ContactPickerActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.opentasker.core.engine.AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="OpenTasker automation engine — runs user-defined profiles when their contexts match" />
        </service>

        <service
            android:name="com.opentasker.core.contexts.NotificationTriggerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Shizuku and Sui hand the app their binder only through this provider. The library ships
             the permission and V3_SUPPORT entries but leaves the provider to the app, and without it
             pingBinder stays false however the server was started or the permission granted. The
             system-only permission keeps ordinary apps out of the exported surface. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name="com.opentasker.core.contexts.CompanionPresenceService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!--
            Exported because DEVICE_ADMIN_ENABLED is delivered by the system, and guarded by
            BIND_DEVICE_ADMIN, which only the system holds. Its policy set is force-lock alone.
        -->
        <receiver
            android:name="com.opentasker.core.platform.LockDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.engine.BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.engine.DirectBootTimeReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.opentasker.action.DIRECT_BOOT_TIME_TICK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.contexts.SmsReceivedReceiver"
            android:enabled="${smsTriggerEnabled}"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.automation.receiver.TimeEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.opentasker.automation.TIME_TICK" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.opentasker.core.scenes.SceneOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Scene overlay — displays user-defined floating UI panels" />
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot2"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot3"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="com.opentasker.core.contexts.QuickSettingsTileServiceSlot4"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name="com.opentasker.core.contexts.QuickSettingsTileConfigActivity"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.widget.TaskRunActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <activity
            android:name="com.opentasker.widget.TaskWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.opentasker.widget.TaskWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_task_info" />
        </receiver>

        <receiver
            android:name="com.opentasker.core.actions.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.opentasker.action.NOTIFICATION_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
            UnifiedPush distributors may forward a delivery here. The receiver is exported because
            the distributor is a separate application; every payload still requires the per-install
            token shown in Setup and is bounded/redacted by PushContextEvents.
        -->
        <receiver
            android:name="com.opentasker.core.contexts.PushEventReceiver"
            android:exported="true"
            android:intentMatchingFlags="enforceIntentFilter">
            <intent-filter>
                <action android:name="com.opentasker.action.PUSH_EVENT" />
            </intent-filter>
        </receiver>

        <!--
            The connector SDK owns the UnifiedPush protocol broadcasts, RFC 8291 decryption, and
            MESSAGE_ACK. This app service receives only the already-decrypted bytes message.
        -->
        <service
            android:name="com.opentasker.core.contexts.UnifiedPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.opentasker.core.actions.PackageArchiveStatusReceiver"
            android:exported="false" />

        <receiver
            android:name="com.opentasker.core.scripting.TermuxResultReceiver"
            android:exported="false" />

        <receiver
            android:name="com.opentasker.core.external.AutomationTargetReceiver"
            android:exported="true"
            android:intentMatchingFlags="enforceIntentFilter"
            android:permission="com.opentasker.permission.AUTOMATION">
            <intent-filter>
                <action android:name="com.opentasker.action.RUN_TASK" />
                <action android:name="com.opentasker.action.SET_PROFILE_ENABLED" />
                <action android:name="com.opentasker.action.QUERY_STATUS" />
                <action android:name="com.opentasker.action.QUERY_EXECUTION" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.opentasker.core.plugins.locale.LocaleSettingEditActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/locale_setting_edit_title"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.opentasker.core.plugins.locale.LocaleConditionEditActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/locale_condition_edit_title"
            android:theme="@style/Theme.OpenTasker">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_CONDITION" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.opentasker.core.plugins.locale.LocaleSettingFireReceiver"
            android:exported="true"
            android:intentMatchingFlags="enforceIntentFilter">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.opentasker.core.plugins.locale.LocaleConditionQueryReceiver"
            android:exported="true"
            android:intentMatchingFlags="enforceIntentFilter">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
