    <!-- Action eligibility and setup diagnostics displayed by the dynamic catalog. -->
    <string name="capability_ready" formatted="false">Ready</string>
    <string name="capability_unknown_action">Unknown actions are not classified and cannot be added, imported, or enabled.</string>
    <string name="capability_notification_permission" formatted="false">Requires notification permission on Android 13+.</string>
    <string name="capability_notification_cancel_permission" formatted="false">Cancels a posted notification by tag and/or ID. Requires notification permission on Android 13+.</string>
    <string name="capability_notification_progress" formatted="false">Requires notification permission on Android 13+; uses ProgressStyle on Android 16+ and requests optional promoted ongoing treatment while progress is active, with a standard progress bar fallback.</string>
    <string name="capability_locale_fire_setup" formatted="false">Requires an installed Locale-compatible plugin; requests are dispatched only to an explicit package.</string>
    <string name="capability_locale_query_setup" formatted="false">Requires an installed Locale-compatible condition plugin; queries are explicit ordered broadcasts with timeout handling.</string>
    <string name="capability_wifi_unsupported" formatted="false">Android 10+ blocks direct Wi-Fi toggles for normal apps.</string>
    <string name="capability_bluetooth_unsupported" formatted="false">Android 13+ blocks direct Bluetooth enable/disable for normal apps.</string>
    <string name="capability_bluetooth_permission" formatted="false">Requires Bluetooth permission.</string>
    <string name="capability_write_settings" formatted="false">Requires Write Settings special access.</string>
    <string name="capability_settings_write_setup" formatted="false">Writing a Global or Secure setting needs one-time access granted from a computer over a cable, set up in Setup. The System table uses Modify system settings instead.</string>
    <string name="capability_app_kill_unsupported" formatted="false">Force-stopping another app requires privileged app-management access that no normal app can hold.</string>
    <string name="capability_app_archive_ready" formatted="false">Uses Android 15+ PackageInstaller archive requests. OpenTasker is not the installer of record, so Android asks you to confirm each request on screen; run this action with OpenTasker open.</string>
    <string name="capability_app_archive_unsupported" formatted="false">Package archive requests require Android 15 (API 35) or newer.</string>
    <string name="capability_local_network_setup" formatted="false">Android 17+ requires local network access for the LAN broadcast; grant it in Setup.</string>
    <string name="capability_dnd_access" formatted="false">Requires Do Not Disturb access.</string>
    <string name="capability_zen_rule_access" formatted="false">Requires Do Not Disturb access; Android 15+ uses owned Zen rules with device effects.</string>
    <string name="capability_torch_ready" formatted="false">Uses the camera flashlight.</string>
    <string name="capability_aod_unsupported" formatted="false">Always-on display changes require Shizuku permission and its privileged user-service transport, and some builds ignore the setting entirely. A display that stays on uses more battery.</string>
    <string name="capability_sun_times_setup" formatted="false">Needs location access only when latitude or longitude is left blank, to read the phone\'s location.</string>
    <string name="capability_wifi_scan_setup" formatted="false">Scanning needs location access, and Nearby Wi-Fi devices on Android 13 and later. Android rate-limits scans, so results may be the last cached scan rather than a fresh one.</string>
    <string name="capability_airplane_unsupported" formatted="false">Airplane mode changes require Shizuku permission and its privileged user-service transport. Turning it on cuts calls, mobile data and usually Wi-Fi until something turns it back off.</string>
    <string name="capability_mobile_data_unsupported" formatted="false">Mobile data changes require Shizuku permission and its privileged user-service transport. Turning it off stops anything that needs data, including remote access to this phone.</string>
    <string name="capability_hotspot_unsupported" formatted="false">The Wi-Fi hotspot requires Android 11 or newer, Shizuku permission and its privileged user-service transport. Anyone with the saved password can join, and connected devices use your mobile data.</string>
    <string name="capability_hotspot_android_version" formatted="false">The Wi-Fi hotspot action needs Android 11 or newer.</string>
    <string name="capability_screenshot_unsupported" formatted="false">Screenshots require Shizuku permission and its privileged user-service transport. Each one saves whatever is on screen to OpenTasker\'s storage, passwords and messages included.</string>
    <string name="capability_reboot_unsupported" formatted="false">Reboot requires Shizuku permission and its privileged user-service transport. The phone restarts right away with no warning and unsaved work is lost. A reboot task on a boot trigger can loop.</string>
    <string name="capability_lock_setup" formatted="false">Requires the Lock screen device admin, which you turn on in Setup.</string>
    <string name="capability_tile_ready" formatted="false">Updates a configured OpenTasker Quick Settings tile.</string>
    <string name="capability_temporary_state_ready" formatted="false">Applies a reversible setting and schedules a durable restore.</string>
    <string name="capability_ime_info_ready" formatted="false">Reports the current and enabled input methods.</string>
    <string name="capability_ime_set_unsupported" formatted="false">Android requires user selection before a normal app can switch the active input method.</string>
    <string name="capability_screen_off_unsupported" formatted="false">Screen-off requires Shizuku permission and its privileged user-service transport. The screen goes dark even if someone is using the phone, and it may lock.</string>
    <string name="capability_wake_unsupported" formatted="false">Wake requires Shizuku permission and its privileged user-service transport. The screen turns on untouched, showing whatever is on the lock screen and using battery.</string>
    <string name="capability_vpn_tunnel_setup" formatted="false">Requires WireGuard or Tailscale. WireGuard also needs its control permission and Allow remote control apps turned on.</string>
    <string name="capability_shizuku_script_setup" formatted="false">Requires Shizuku access and an approved script hash.</string>
    <string name="capability_termux_setup" formatted="false">Requires Termux 0.109 or newer, RUN_COMMAND permission, and an approved script hash.</string>
    <string name="capability_tasker_import_unsupported" formatted="false">The imported Tasker action could not be mapped to a supported OpenTasker action.</string>
    <string name="capability_macrodroid_import_unsupported" formatted="false">The imported MacroDroid action could not be mapped to a supported OpenTasker action.</string>
    <string name="capability_sms_permission" formatted="false">Requires SMS permission; Play builds omit SMS actions for policy compliance.</string>
    <string name="capability_sms_distribution_unsupported" formatted="false">SMS is unavailable in this distribution because SMS and phone-state permissions are omitted for Play policy compliance.</string>
    <string name="capability_contacts_permission" formatted="false">Requires an explicit Contacts permission for unattended lookup; Android 17+ also supports a field-scoped system picker mode.</string>
    <string name="capability_audio_output_restricted" formatted="false">Android 17 restricts audio output unless OpenTasker has a while-in-use eligible foreground-service path.</string>
    <string name="capability_audio_output_ready" formatted="false">Audio output is available.</string>
    <string name="capability_media_key_restricted" formatted="false">Android 17 restricts media-key dispatch unless OpenTasker has a while-in-use eligible foreground-service path.</string>
    <string name="capability_media_key_ready" formatted="false">Media-key dispatch is available.</string>
    <string name="capability_volume_restricted" formatted="false">Android 17 restricts volume changes unless OpenTasker has a while-in-use eligible foreground-service path.</string>
    <string name="capability_volume_policy" formatted="false">May require Do Not Disturb policy access.</string>
</resources>
