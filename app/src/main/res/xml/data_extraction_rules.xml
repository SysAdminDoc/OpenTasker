<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="opentasker.db" />
        <exclude domain="database" path="opentasker.db-shm" />
        <exclude domain="database" path="opentasker.db-wal" />
        <exclude domain="sharedpref" path="" />
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="crash_logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="opentasker.db" />
        <exclude domain="database" path="opentasker.db-shm" />
        <exclude domain="database" path="opentasker.db-wal" />
        <exclude domain="sharedpref" path="" />
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="crash_logs" />
    </device-transfer>
</data-extraction-rules>
